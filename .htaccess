# Performance rules for Apache / cPanel hosting (ignored by other hosts).

# Compress text assets
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Browser caching. CSS/JS bundles are versioned with ?v=<hash> by tools/build.mjs,
# so they can be cached for a year. HTML is always revalidated.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html

# /index.html duplicates the homepage: send it to / (the canonical URL).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Old template pages were removed: send any old links somewhere useful.
<IfModule mod_alias.c>
  Redirect 301 /index-2.html /
  Redirect 301 /index-3.html /
  Redirect 301 /blog.html /
  Redirect 301 /blog-classic.html /
  Redirect 301 /blog-details.html /
  Redirect 301 /portfolio.html /service.html
  Redirect 301 /portfolio-details.html /service.html
  Redirect 301 /award.html /about.html
  Redirect 301 /testimonial.html /about.html
</IfModule>
