# Cache rules for Netlify / Cloudflare Pages (ignored by other hosts).
# CSS/JS bundles are versioned with ?v=<hash> by tools/build.mjs.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=2592000
